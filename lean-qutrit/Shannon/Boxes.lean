def residual : Nat → List Nat
  | 0 => [1279, 1291, 1329, 1622, 1672]
  | 1 => [1014, 1351, 2325]
  | 2 => [320, 860, 867, 908, 915]
  | 3 => [1840, 1882, 2154]
  | 4 => [1879, 1929, 2222, 2260, 2272, 2296]
  | _ => []

private def table : Nat → Nat
  | 0 => table0
  | 1 => table1
  | 2 => table2
  | 3 => table3
  | 4 => table4
  | _ => 0

private def tripleAt (a p : Nat) : List Edge :=
  let raw := table a >>> (27*p)
  clique (raw % 512) ((raw >>> 9) % 512) ((raw >>> 18) % 512)

private def covered (a p : Nat) := (residual a).contains p ||
  (tripleAt a p).all (edgeOK appendix a p)

private def checkedBlock (axis block : Nat) : Bool :=
  (List.range 49).all fun offset => covered axis (49*block + offset)

