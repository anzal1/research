theorem residual_of_packing {a p : Nat} (ha : a < 5) (hp : p < 2401)
    {c : Nat → Letter} (pack : Packing appendix a p c) : p ∈ residual a := by
  have hb : p / 49 < 49 := by omega
  have cover : checkedBlock a (p/49) = true := by
    rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 ∨ a = 4) with h|h|h|h|h <;>
      subst a <;> first | exact covers0 _ hb | exact covers1 _ hb | exact covers2 _ hb | exact covers3 _ hb | exact covers4 _ hb
  have this := List.all_eq_true.mp cover (p%49) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  change covered a (49*(p/49)+p%49) = true at this
  rw [Nat.div_add_mod] at this
  rcases Bool.or_eq_true_iff.mp this with h|h
  · exact List.contains_iff_mem.mp h
  · exact False.elim (clique_excludes h pack)

