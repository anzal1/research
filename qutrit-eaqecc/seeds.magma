F3 := GF(3);
P<x> := PolynomialRing(F3);
F9<w> := ext<F3 | x^2 + 1>;
enc := [F9!0, F9!1, F9!2, w, 1+w, 2+w, 2*w, 1+2*w, 2+2*w];
dec := func<seq | [enc[v + 1] : v in seq]>;

procedure VerifySeed(name, n, M, d_expected, rows_int)
    G_mat := Matrix(F9, M, n, &cat[dec(r) : r in rows_int]);
    D := LinearCode(G_mat);
    C := HermitianDual(D);
    H := D meet C;
    l := Dimension(H);
    d_actual := MinimumWeight(D);
    printf "%-10o : D = [%2o, %2o, %2o]_9 (expected d=%2o), Hull l = %2o -> C = D^{perp_H} gives [[%2o, 0, %2o; %2o]]_3\n",
        name, Length(D), Dimension(D), d_actual, d_expected, l, n, d_actual, n - 2*M;
    assert Dimension(D) eq M and l eq M and d_actual eq d_expected;
end procedure;

// 1. D_{12,3,9} = [12, 3, 9]_9 (l=3) -> [[12, 0, 9; 6]]_3, [[11, 0, 9; 7]]_3
VerifySeed("D_12_3_9", 12, 3, 9, [
    [4, 6, 2, 3, 5, 7, 3, 8, 7, 5, 2, 3],
    [7, 4, 6, 2, 3, 5, 3, 3, 8, 7, 5, 2],
    [5, 7, 4, 6, 2, 3, 2, 3, 3, 8, 7, 5]
]);

